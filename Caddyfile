{
	admin off
	persist_config off
	auto_https off
}

:{$PORT:8080} {
	root * /srv

	# The Hungarian invitation is the home page.
	redir / /hu/ 302

	# Vite output under /assets is content-hashed, so it is cached forever.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	file_server

	# Unknown paths land on the invitation, as the old single-page app did.
	handle_errors 404 {
		redir * /hu/ 302
	}
}
